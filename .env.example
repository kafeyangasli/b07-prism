DATABASE_URL="spooky_url"
DATABASE_USERNAME="spooky_user"
DATABASE_PASSWORD="spooky_password"

# Persistent facility images (mount this directory as a volume in containers).
PRISM_FACILITY_STORAGE="./storage/facilities"
PRISM_FACILITY_IMAGE_MAX_BYTES=5242880
PRISM_FACILITY_IMAGE_MAX_COUNT=20
PRISM_MULTIPART_MAX_FILE_SIZE=10MB
PRISM_MULTIPART_MAX_REQUEST_SIZE=110MB
