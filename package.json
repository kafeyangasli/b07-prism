{
  "name": "prism-ui",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i src/main/resources/static/css/prism.css -o ./src/main/resources/static/css/app.css --minify",
    "build:vendor": "node ./scripts/copy-htmx.mjs",
    "watch:css": "tailwindcss -i src/main/resources/static/css/prism.css -o ./src/main/resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.1",
    "htmx.org": "2.0.10",
    "tailwindcss": "4.2.1"
  }
}
