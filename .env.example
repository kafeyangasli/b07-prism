# Example local configuration matching README.md.
# The application does not load .env automatically: export these variables in
# your terminal or configure them in your IDE/service before starting PRISM.

# MySQL connection (replace the example password with your local password).
DATABASE_URL="jdbc:mysql://localhost:3306/prism"
DATABASE_USERNAME="prism_app"
DATABASE_PASSWORD="ganti_dengan_password_lokal"

# Persistent storage paths, relative to the application's working directory.
# Mount these directories as volumes when running in containers.
PRISM_PROPOSAL_STORAGE="./storage/proposals"
PRISM_FACILITY_STORAGE="./storage/facilities"
PRISM_AVATAR_STORAGE="./storage/avatars"

# Image limits (bytes; 5242880 = 5 MiB).
PRISM_AVATAR_MAX_BYTES=5242880
PRISM_FACILITY_IMAGE_MAX_BYTES=5242880
PRISM_FACILITY_IMAGE_MAX_COUNT=20

# Multipart upload limits.
PRISM_MULTIPART_MAX_FILE_SIZE=10MB
PRISM_MULTIPART_MAX_REQUEST_SIZE=110MB

# Reservation lifecycle processing interval, in milliseconds.
PRISM_RESERVATION_LIFECYCLE_MS=60000

# Development seed: initial facilities, images, and known demo credentials.
PRISM_SEED_ENABLED=true
PRISM_SEED_DIRECTORY="./initial_data"

# Production: activate the prod profile AND set PRISM_SEED_ENABLED=false above.
# SPRING_PROFILES_ACTIVE=prod
